generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String?
  role            String    @default("USER")
  ownerStatus     String?
  ownerRequest    String?
  ownerVerifiedAt DateTime?
  emailVerified   DateTime?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  suspendedAt     DateTime?
  moderationPermissions String[] @default([])

  accounts      Account[]
  sessions      Session[]
  places        Place[]        @relation("PlaceOwner")
  reviews       Review[]
  favorites     Favorite[]
  events        Event[]        @relation("EventOrganizer")
  ownerRequests OwnerRequest[]
  reservations  Reservation[]  @relation("ReservationCustomer")
  collaborations PlaceCollaborator[]
  reviewResponses OwnerReviewResponse[]
  waitlistEntries ReservationWaitlist[]
  reviewReports ReviewReport[]
  adminMessages AdminMessage[]
  receivedMessages MessageRecipient[]
  adminAuditLogs AdminAuditLog[]
  reservationHistory ReservationStatusEvent[]
  newsletterCampaigns NewsletterCampaign[]

  @@map("users")
}

model NewsletterSubscriber {
  id             String @id @default(cuid())
  email          String @unique
  status         String @default("PENDING")
  tokenVersion   String
  consentAt      DateTime @default(now())
  requestedAt    DateTime @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  deliveries     NewsletterDelivery[]

  @@index([status, requestedAt])
  @@map("newsletter_subscribers")
}

model NewsletterCampaign {
  id          String @id
  subject     String
  body        String
  revision    Int @default(1)
  status      String @default("DRAFT")
  createdAt   DateTime @default(now())
  queuedAt    DateTime?
  creatorId   String?
  creator     User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  deliveries  NewsletterDelivery[]

  @@index([createdAt])
  @@map("newsletter_campaigns")
}

model NewsletterDelivery {
  id             String @id @default(cuid())
  dedupeKey      String @unique
  subscriberId   String
  subscriber     NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  campaignId     String?
  campaign       NewsletterCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind           String
  tokenVersion   String
  status         String @default("PENDING")
  attempts       Int @default(0)
  firstAttemptAt DateTime?
  attemptAt      DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([status, attemptAt])
  @@index([campaignId, status])
  @@map("newsletter_deliveries")
}

model NewsletterRateLimit {
  key       String @id
  count     Int @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("newsletter_rate_limits")
}

model AdminMessage {
  id         String @id @default(cuid())
  requestKey String @unique
  requestFingerprint String
  subject    String
  body       String
  audience   String
  kind       String @default("ADMIN")
  expiresAt  DateTime?
  reservationId String?
  expectedReservationStatus String?
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sendEmail  Boolean @default(false)
  createdAt  DateTime @default(now())
  senderId   String?
  sender     User? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]

  @@index([createdAt])
  @@map("admin_messages")
}

model MessageRecipient {
  id           String @id @default(cuid())
  messageId    String
  userId       String
  readAt       DateTime?
  emailStatus  String @default("NOT_REQUESTED")
  emailAttempts Int @default(0)
  emailAttemptAt DateTime?
  emailFirstAttemptAt DateTime?
  emailSentAt  DateTime?
  emailError   String?
  message      AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([emailStatus, emailAttemptAt])
  @@map("message_recipients")
}

model AdminAuditLog {
  id        String @id @default(cuid())
  actorId   String?
  action    String
  targetId  String
  details   Json?
  createdAt DateTime @default(now())
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_audit_logs")
}

model PlaceInteraction {
  id         String   @id @default(cuid())
  type       String
  visitorKey String
  createdAt  DateTime @default(now())
  placeId    String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, type, createdAt])
  @@map("place_interactions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model OwnerRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeName    String
  placeAddress String
  placePhone   String?
  description  String?
  status       String    @default("PENDING")
  adminNote    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([status, createdAt])
  @@map("owner_requests")
}

model Place {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  description             String
  address                 String
  neighborhood            String
  latitude                Float
  longitude               Float
  priceRange              Int
  phone                   String?
  status                  String   @default("PENDING")
  reservationsEnabled     Boolean  @default(true)
  reservationPriceMinor   Int      @default(0)
  reservationCurrency     String   @default("USD")
  reservationDuration     Int      @default(120)
  reservationCapacity     Int      @default(40)
  maxPartySize            Int      @default(12)
  autoConfirmReservations Boolean  @default(true)
  reservationStartTime    String   @default("11:00")
  reservationEndTime      String   @default("23:00")
  reservationInterval     Int      @default(30)
  commercialStatus        String   @default("PILOT")
  pilotStartedAt          DateTime @default(now())
  menuVisible             Boolean  @default(false)
  amenities              String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  owner        User            @relation("PlaceOwner", fields: [ownerId], references: [id])
  ownerId      String
  categories   PlaceCategory[]
  reviews      Review[]
  favorites    Favorite[]
  events       Event[]
  media        Media[]
  reservations Reservation[]
  reservationDays ReservationDay[]
  visits       PlaceVisit[]
  menuItems    MenuItem[]
  collaborators PlaceCollaborator[]
  waitlistEntries ReservationWaitlist[]
  interactions PlaceInteraction[]

  @@index([neighborhood])
  @@index([status, createdAt])
  @@index([ownerId])
  @@map("places")
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       String?
  category    String?
  imageUrl    String?
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  placeId     String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
  @@map("menu_items")
}

model Category {
  id     String          @id @default(cuid())
  name   String          @unique
  slug   String          @unique
  places PlaceCategory[]

  @@map("categories")
}

model PlaceCategory {
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@id([placeId, categoryId])
  @@map("place_categories")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  place    Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId  String
  response OwnerReviewResponse?
  reports  ReviewReport[]

  @@index([placeId, status, createdAt])
  @@unique([authorId, placeId])
  @@map("reviews")
}

model ReviewReport {
  id         String   @id @default(cuid())
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  reviewId   String
  reporterId String

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@map("review_reports")
}

model OwnerReviewResponse {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviewId  String   @unique
  authorId  String

  review  Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author  User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("owner_review_responses")
}

model PlaceCollaborator {
  id        String   @id @default(cuid())
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  placeId   String
  userId    String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([userId])
  @@map("place_collaborators")
}

model Favorite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId   String
  createdAt DateTime @default(now())

  @@id([userId, placeId])
  @@map("favorites")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizer   User    @relation("EventOrganizer", fields: [organizerId], references: [id])
  organizerId String
  place       Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId     String
  media       Media[]

  @@index([startDate])
  @@map("events")
}

model Media {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  createdAt DateTime @default(now())
  placeId   String?
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("media")
}

model Reservation {
  id             String    @id @default(cuid())
  reference      String    @unique
  dateTime       DateTime
  partySize      Int
  status         String    @default("PENDING")
  phone          String?
  specialRequest String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cancelledAt    DateTime?
  reminderSentAt DateTime?
  reminderQueuedAt DateTime?
  requestKey     String? @unique
  requestFingerprint String?
  ownerIdAtBooking String?
  source         String @default("QUIVIBE")
  channel        String @default("UNKNOWN")
  attributedVisitId String?
  // Price agreed at booking; independent of the eventual reported bill.
  reservationPriceMinor Int @default(0)
  reservationCurrency String @default("USD")
  durationMinutes Int @default(120)
  totalAmount    Decimal? @db.Decimal(12, 2)
  currency       String?
  commissionRate Decimal @default(0) @db.Decimal(5, 4)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  paymentStatus  String @default("NOT_TRACKED")
  history        ReservationStatusEvent[]
  notifications  AdminMessage[]
  attributedVisit PlaceVisit? @relation(fields: [attributedVisitId], references: [id], onDelete: SetNull)

  customer   User   @relation("ReservationCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  place      Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId    String

  @@index([customerId, dateTime])
  @@index([placeId, dateTime, status])
  @@index([placeId, createdAt])
  @@index([attributedVisitId])
  @@map("reservations")
}

model ReservationDay {
  id String @id @default(cuid())
  placeId String
  date DateTime @db.Date
  closed Boolean @default(false)
  closedTimes String[] @default([])
  updatedAt DateTime @updatedAt
  updatedById String?
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, date])
  @@map("reservation_days")
}

model ReservationStatusEvent {
  id            String @id @default(cuid())
  reservationId String
  fromStatus    String?
  toStatus      String
  actorId       String?
  actorRole     String
  createdAt     DateTime @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  actor         User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
  @@index([createdAt, actorRole])
  @@map("reservation_status_events")
}

model ReservationWaitlist {
  id         String   @id @default(cuid())
  date       DateTime
  partySize  Int
  status     String   @default("WAITING")
  notifiedAt DateTime?
  createdAt  DateTime @default(now())
  placeId    String
  customerId String

  place    Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([placeId, customerId, date])
  @@index([placeId, date, status])
  @@map("reservation_waitlist")
}

model PlaceVisit {
  id         String   @id @default(cuid())
  visitorKey String
  visitedAt  DateTime @default(now())
  placeId    String
  channel    String @default("UNKNOWN")
  reservations Reservation[]

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, visitedAt])
  @@index([visitorKey, visitedAt])
  @@map("place_visits")
}
